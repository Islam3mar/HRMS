@model IEnumerable<HRMS.Domain.Entities.AttendanceRecord>
@{
    Layout = null;

    var grouped = Model
        .GroupBy(r => r.EmployeeId)
        .Select(g => new
        {
            EmployeeName = g.First().Employee.FullName,
            DepartmentName = g.First().Employee.Department?.Name ?? "-",
            Records = g.OrderByDescending(r => r.Date).ToList()
        })
        .OrderBy(g => g.EmployeeName)
        .ToList();
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>تقرير الحضور و الانصراف</title>
    <style>
            body {
                font-family: 'Cairo', Arial, Tahoma, sans-serif;
                padding: 20px;
                color: #1F2933;
            }

            h3 {
                text-align: center;
                margin-bottom: 20px;
            }

            .employee-section {
                margin-bottom: 26px;
                page-break-inside: avoid;
            }

            .employee-title {
                background-color: #E4F0F3;
                color: #0B3D4C;
                font-weight: bold;
                padding: 8px 12px;
                border: 1px solid #999;
                border-bottom: none;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th, td {
                border: 1px solid #999;
                padding: 8px;
                text-align: center;
            }

            th {
                background-color: #f2f2f2;
            }

            .print-toolbar {
                text-align: center;
                margin-bottom: 15px;
            }

                .print-toolbar button {
                    background-color: #E8593F;
                    color: #fff;
                    border: none;
                    border-radius: 6px;
                    padding: 8px 20px;
                    font-size: 14px;
                    cursor: pointer;
                }

            @@media print {
                .print-toolbar {
                    display: none;
                }
            }
    </style>
</head>
<body>
    <div class="print-toolbar">
        <button onclick="window.print()">طباعة</button>
    </div>

    <h3>تقرير الحضور و الانصراف للموظفين</h3>

    @foreach (var group in grouped)
    {
        <div class="employee-section">
            <div class="employee-title">@group.EmployeeName — @group.DepartmentName (@group.Records.Count سجل)</div>
            <table>
                <thead>
                    <tr>
                        <th>م</th>
                        <th>التاريخ</th>
                        <th>وقت الحضور</th>
                        <th>وقت الانصراف</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var i = 1;
                    }
                    @foreach (var record in group.Records)
                    {
                        <tr>
                            <td>@(i++)</td>
                            <td>@record.Date.ToString("yyyy/MM/dd")</td>
                            <td>@record.CheckInTime.ToString(@"hh\:mm")</td>
                            <td>@record.CheckOutTime.ToString(@"hh\:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</body>
</html>