@model HRMS.Web.ViewModels.DepartmentsIndexViewModel
@{
    ViewData["Title"] = "الأقسام";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="card mx-auto" style="max-width: 700px;">
    <div class="card-header text-center">الأقسام</div>
    <div class="card-body">
        <form asp-controller="Departments" asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Form.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-3 align-items-end mb-2">
                <div class="col-md-8 order-md-2">
                    <label asp-for="Form.Name" class="form-label"></label>
                    <input asp-for="Form.Name" class="form-control" placeholder="اسم القسم" />
                </div>
                <div class="col-md-4 order-md-1">
                    <button type="submit" id="submitBtn" class="btn btn-brand w-100">
                        اضافة
                    </button>
                </div>
            </div>

            <div class="row">
                <div class="col-md-8 offset-md-4">
                    <span asp-validation-for="Form.Name" class="text-danger d-block"></span>
                </div>
            </div>
        </form>

        <div class="table-wrap mt-4">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>اسم القسم</th>
                        <th class="text-center">العمليات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var department in Model.Departments)
                    {
                        <tr>
                            <td>@department.Name</td>
                            <td class="text-center">
                                <button type="button" class="btn-icon edit-btn"
                                        title="تعديل"
                                        data-id="@department.Id" data-name="@department.Name">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>

                                <form asp-controller="Departments" asp-action="Delete" asp-route-id="@department.Id"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('هل انت متأكد من حذف هذا القسم؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-icon danger" title="حذف">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.querySelectorAll('.edit-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.getElementById('Form_Id').value = btn.dataset.id;
                document.getElementById('Form_Name').value = btn.dataset.name;
                document.getElementById('submitBtn').textContent = 'حفظ التعديل';
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        });
    </script>
}