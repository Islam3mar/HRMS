<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HRMS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HRMS.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var current = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLower();
        bool IsActive(string controller) => current == controller.ToLower();
    }

    <div class="app-shell" id="appShell">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside class="sidebar">
                <div class="sidebar-brand">
                    <img src="~/images/pioneers-solutions-logo.png" alt="Pioneers" />
                    <span>HRMS</span>
                </div>

                <div class="sidebar-group">الرئيسية</div>
                <ul class="sidebar-nav">
                    <li><a class="nav-link @(IsActive("Home") ? "active" : "")" asp-controller="Home" asp-action="Index" title="الرئيسية"><i class="bi bi-house"></i> <span>الرئيسية</span></a></li>
                </ul>

                <div class="sidebar-group">بيانات الموظفين</div>
                <ul class="sidebar-nav">
                    <li><a class="nav-link @(IsActive("Employees") ? "active" : "")" asp-controller="Employees" asp-action="Index" title="الموظفين"><i class="bi bi-people"></i> <span>الموظفين</span></a></li>
                    <li><a class="nav-link @(IsActive("Departments") ? "active" : "")" asp-controller="Departments" asp-action="Index" title="الأقسام"><i class="bi bi-diagram-3"></i> <span>الأقسام</span></a></li>
                    <li><a class="nav-link @(IsActive("Attendance") ? "active" : "")" asp-controller="Attendance" asp-action="Index" title="الحضور والانصراف"><i class="bi bi-calendar-check"></i> <span>الحضور والانصراف</span></a></li>
                </ul>

                <div class="sidebar-group">الرواتب</div>
                <ul class="sidebar-nav">
                    <li><a class="nav-link @(IsActive("Payroll") ? "active" : "")" asp-controller="Payroll" asp-action="Index" title="رواتب الموظفين"><i class="bi bi-cash-stack"></i> <span>رواتب الموظفين</span></a></li>
                    <li><a class="nav-link @(IsActive("OfficialHolidays") ? "active" : "")" asp-controller="OfficialHolidays" asp-action="Index" title="الإجازات الرسمية"><i class="bi bi-calendar-event"></i> <span>الإجازات الرسمية</span></a></li>
                    <li><a class="nav-link @(IsActive("Settings") ? "active" : "")" asp-controller="Settings" asp-action="Index" title="الإعدادات العامة"><i class="bi bi-sliders"></i> <span>الإعدادات العامة</span></a></li>
                </ul>

                <div class="sidebar-group">الإدارة</div>
                <ul class="sidebar-nav">
                    <li><a class="nav-link @(IsActive("Users") ? "active" : "")" asp-controller="Users" asp-action="Index" title="مستخدمين النظام"><i class="bi bi-person-badge"></i> <span>مستخدمين النظام</span></a></li>
                    <li><a class="nav-link @(IsActive("Roles") ? "active" : "")" asp-controller="Roles" asp-action="Index" title="مجموعات المستخدمين"><i class="bi bi-shield-lock"></i> <span>مجموعات المستخدمين</span></a></li>
                </ul>
            </aside>
        }

        <div class="app-main">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <header class="topbar">
                    <div class="topbar-start">
                        <button class="sidebar-toggle" id="sidebarToggle" title="فتح القائمة"><i class="bi bi-list"></i></button>
                        <button class="collapse-toggle" id="collapseToggle" title="طي/توسيع القائمة الجانبية">
                            <i class="bi bi-layout-sidebar-inset"></i>
                        </button>
                        <span class="fw-bold" style="color:var(--teal-900)">@ViewData["Title"]</span>
                    </div>
                    <div class="topbar-user">
                        <span><i class="bi bi-person-circle"></i> @User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm">تسجيل الخروج</button>
                        </form>
                    </div>
                </header>
            }

            <main class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
            var appShell = document.getElementById('appShell');

            // موبايل: فتح/قفل القائمة كامل شاشة
            document.getElementById('sidebarToggle')?.addEventListener('click', function () {
                appShell.classList.toggle('sidebar-open');
            });

            // ديسكتوب: طي القائمة لأيقونات بس (بيتفكر آخر حالة)
            var collapseToggle = document.getElementById('collapseToggle');
            if (localStorage.getItem('hrms-sidebar-collapsed') === '1') {
                appShell.classList.add('sidebar-collapsed');
            }
            collapseToggle?.addEventListener('click', function () {
                appShell.classList.toggle('sidebar-collapsed');
                localStorage.setItem('hrms-sidebar-collapsed', appShell.classList.contains('sidebar-collapsed') ? '1' : '0');
            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>