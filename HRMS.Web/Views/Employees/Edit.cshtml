@model HRMS.Web.ViewModels.EmployeeFormViewModel
@{
    ViewData["Title"] = "تعديل بيانات الموظف";
}

<div dir="rtl">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">الموظفين</a></li>
            <li class="breadcrumb-item active">تعديل بيانات الموظف</li>
        </ol>
    </nav>

    <div class="card">
        <div class="card-header text-center fw-bold">الموظفين</div>
        <div class="card-body">
            <form id="employeeForm" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6 border-end">
                        <h6 class="fw-bold mb-3">بيانات العمل</h6>

                        <div class="mb-3">
                            <label asp-for="ContractDate" class="form-label"></label>
                            <input asp-for="ContractDate" class="form-control" />
                            <span asp-validation-for="ContractDate" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Salary" class="form-label"></label>
                            <input asp-for="Salary" class="form-control" />
                            <span asp-validation-for="Salary" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="AttendanceTime" class="form-label"></label>
                            <input asp-for="AttendanceTime" class="form-control" />
                            <span asp-validation-for="AttendanceTime" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DepartureTime" class="form-label"></label>
                            <input asp-for="DepartureTime" class="form-control" />
                            <span asp-validation-for="DepartureTime" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DepartmentId" class="form-label"></label>
                            <select asp-for="DepartmentId" asp-items="Model.DepartmentOptions" class="form-select">
                                <option value="">-- بدون قسم --</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3">البيانات الاساسية</h6>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label"></label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Gender" class="form-label"></label>
                            <select asp-for="Gender" asp-items="Model.GenderOptions" class="form-select"></select>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Nationality" class="form-label"></label>
                            <input asp-for="Nationality" class="form-control" />
                            <span asp-validation-for="Nationality" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="BirthDate" class="form-label"></label>
                            <input asp-for="BirthDate" class="form-control" />
                            <span asp-validation-for="BirthDate" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NationalId" class="form-label"></label>
                            <input asp-for="NationalId" class="form-control" />
                            <span asp-validation-for="NationalId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="text-start mt-3">
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal">حذف</button>
                    <button type="button" class="btn" style="background-color:#ff6b81; color:white;" data-bs-toggle="modal" data-bs-target="#editConfirmModal">تعديل</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
                </div>
            </form>

            <!-- Pop Up تأكيد التعديل - قاعدة رقم 8 -->
            <div class="modal fade" id="editConfirmModal" tabindex="-1">
                <div class="modal-dialog" dir="rtl">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">تأكيد التعديل</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">هل أنت متأكد من حفظ التعديلات على بيانات هذا الموظف؟</div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                            <button type="button" class="btn" style="background-color:#ff6b81; color:white;"
                                    onclick="document.getElementById('employeeForm').submit();">
                                تأكيد
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pop Up تأكيد الحذف - قاعدة رقم 9 -->
            <div class="modal fade" id="deleteConfirmModal" tabindex="-1">
                <div class="modal-dialog" dir="rtl">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">تأكيد الحذف</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">هل أنت متأكد من حذف بيانات هذا الموظف؟ لا يمكن التراجع عن هذا الاجراء.</div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger">حذف</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
