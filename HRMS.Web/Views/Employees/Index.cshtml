@model HRMS.Domain.Common.PagedResult<HRMS.Domain.Entities.Employee>
@{
    ViewData["Title"] = "الموظفين";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">الموظفين</h4>
    <a asp-action="Create" class="btn btn-brand"><i class="bi bi-plus-lg"></i> اضافة موظف جديد</a>
</div>

<div class="table-wrap">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>اسم الموظف</th>
                <th>القسم</th>
                <th>رقم تليفون</th>
                <th>الرقم القومي</th>
                <th>تاريخ التعاقد</th>
                <th>الراتب</th>
                <th class="text-center">الحالة</th>
                <th class="text-center">العمليات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model.Items)
            {
                <tr class="@(emp.IsActive ? "" : "text-muted")">
                    <td>@emp.FullName</td>
                    <td>@(emp.Department?.Name ?? "-")</td>
                    <td>@emp.PhoneNumber</td>
                    <td>@emp.NationalId</td>
                    <td>@emp.ContractDate.ToString("yyyy/MM/dd")</td>
                    <td>@emp.Salary.ToString("N2")</td>
                    <td class="text-center">
                        @if (emp.IsActive)
                        {
                            <span class="badge bg-success">نشط</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">منتهي الخدمة</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@emp.Id" class="btn-icon" title="تعديل / حذف">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}