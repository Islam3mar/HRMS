@model HRMS.Web.ViewModels.PayrollIndexViewModel
@{
    ViewData["Title"] = "رواتب الموظفين";
}

<h4 class="fw-bold mb-4">رواتب الموظفين</h4>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (Model.SearchError != null)
{
    <div class="alert alert-warning">@Model.SearchError</div>
}
@if (Model.YearError != null)
{
    <div class="alert alert-warning">@Model.YearError</div>
}

<form id="searchForm" asp-controller="Payroll" asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-1 d-flex align-items-end">
        <div>
            <label class="form-label">اليوم</label>
            <div id="currentDayDisplay" class="form-control-plaintext" style="padding-top: .375rem;">@DateTime.Today.ToString("dddd, yyyy/MM/dd", new System.Globalization.CultureInfo("ar-EG"))</div>
        </div>
    </div>
    <div class="col-md-5">
        <label class="form-label">بحث باسم الموظف</label>
        <input asp-for="Search.EmployeeName" class="form-control" placeholder="بحث باسم الموظف" />
    </div>
    <div class="col-md-2">
        <label class="form-label">شهر</label>
        <select asp-for="Search.Month" asp-items="Model.MonthOptions" class="form-select"></select>
    </div>
    <div class="col-md-2">
        <label class="form-label">سنة</label>
        <div class="d-flex">
            <select asp-for="Search.Year" asp-items="Model.YearOptions" class="form-select"></select>
            <button type="button" class="btn btn-sm btn-outline-primary ms-2" onclick="setToToday()" title="اختر الشهر والسنة الحالية">اليوم</button>
        </div>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">
            <i class="bi bi-search"></i> بحث
        </button>
    </div>
</form>

<script>
    function setToToday() {
        try {
            const now = new Date();
            const month = now.getMonth() + 1; // JS months 0-11
            const year = now.getFullYear();
            const monthEl = document.getElementById('Search_Month');
            const yearEl = document.getElementById('Search_Year');
            if (monthEl) monthEl.value = month;
            if (yearEl) yearEl.value = year;
            const form = document.getElementById('searchForm');
            if (form) form.submit();
        } catch (e) {
            console.error(e);
        }
    }

    // Update the current day display and schedule next update at midnight so it "changes by itself" when the day ends
    (function initCurrentDayUpdater(){
        const el = document.getElementById('currentDayDisplay');
        if (!el) return;

        function formatToday(locale){
            try {
                const now = new Date();
                const formatter = new Intl.DateTimeFormat('ar-EG', { weekday: 'long', year: 'numeric', month: '2-digit', day: '2-digit' });
                return formatter.format(now);
            } catch { return new Date().toLocaleDateString(); }
        }

        function update(){
            el.textContent = formatToday('ar-EG');
            // compute ms until next midnight
            const now = new Date();
            const tomorrow = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
            const ms = tomorrow.getTime() - now.getTime() + 1000; // small buffer
            setTimeout(update, ms);
        }

        update();
    })();
</script>

<div class="table-wrap">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th class="text-center">العمليات</th>
                <th>الصافى</th>
                <th>اجمالى الخصم</th>
                <th>اجمالى الاضافى</th>
                <th>الخصم بالساعات</th>
                <th>الاضافى بالساعات</th>
                <th>عدد ايام الغياب</th>
                <th>عدد ايام الحضور</th>
                <th>الراتب الاساسى</th>
                <th>القسم</th>
                <th>اسم الموظف</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Rows.Any())
            {
                <tr>
                    <td colspan="11" class="text-center py-4" style="color:var(--ink-500)">لا توجد بيانات لعرضها</td>
                </tr>
            }
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td class="text-center">
                        <a class="btn-icon"
                           asp-action="Edit"
                           asp-route-employeeId="@row.EmployeeId"
                           asp-route-month="@row.Month"
                           asp-route-year="@row.Year"
                           title="تعديل الراتب">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        <a class="btn-icon"
                           asp-action="Print"
                           asp-route-employeeId="@row.EmployeeId"
                           asp-route-month="@row.Month"
                           asp-route-year="@row.Year"
                           target="_blank" title="طباعة مفردات الراتب">
                            <i class="bi bi-printer-fill"></i>
                        </a>
                    </td>
                    <td class="fw-bold">@row.NetSalary.ToString("N2")</td>
                    <td>@row.TotalDeductionAmount.ToString("N2")</td>
                    <td>@row.TotalOvertimeAmount.ToString("N2")</td>
                    <td>@row.DeductionHours.ToString("N2")</td>
                    <td>@row.OvertimeHours.ToString("N2")</td>
                    <td>@row.AbsenceDaysCount</td>
                    <td>@row.AttendanceDaysCount</td>
                    <td>@row.BaseSalary.ToString("N2")</td>
                    <td>@row.DepartmentName</td>
                    <td>@row.EmployeeName</td>
                </tr>
            }
        </tbody>
    </table>
</div>