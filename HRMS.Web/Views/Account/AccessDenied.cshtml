@{
    Layout = null;
    ViewData["Title"] = "غير مصرح";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-body">
    <div class="login-card" style="text-align:center;">
        <h2>غير مصرح لك بالدخول</h2>
        <p>ليس لديك الصلاحية للوصول إلى هذه الصفحة.</p>
        <a asp-controller="Account" asp-action="Login" class="btn-signin" style="display:inline-block; text-decoration:none;">
            العودة لتسجيل الدخول
        </a>
    </div>
</body>
</html>