@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HRMS</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-shell">
        <div class="login-brand-panel">
            <div class="login-brand-content">
                <img src="~/images/pioneers-solutions-logo.png" alt="Pioneers Solutions" class="login-brand-logo" />
                <h1>نظام إدارة الموارد البشرية</h1>
                <p>منصة موحّدة لمتابعة بيانات الموظفين، الحضور والانصراف، والرواتب بدقة وسهولة.</p>
            </div>
        </div>

        <div class="login-form-panel">
            <div class="login-card">
                <h2>تسجيل الدخول</h2>
                <p class="login-subtitle">من فضلك ادخل بياناتك للمتابعة</p>

                <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                    <div class="form-group">
                        <label asp-for="Username">اسم المستخدم</label>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Username" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">كلمة المرور</label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <button type="submit" class="btn-signin">تسجيل الدخول</button>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>