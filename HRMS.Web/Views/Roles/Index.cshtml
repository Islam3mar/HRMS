@model HRMS.Domain.Common.PagedResult<HRMS.Domain.Entities.Role>
@{
    ViewData["Title"] = "مجموعة المستخدمين";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">مجموعة المستخدمين</h3>
    <a asp-action="Create" class="btn btn-primary">+ اضافة مجموعة جديدة</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (!Model.Items.Any())
{
    <div class="alert alert-info">لا توجد مجموعات مضافة حتى الآن.</div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>اسم المجموعة</th>
                <th>عدد الصفحات المسموح بها</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Model.Items)
            {
                <tr>
                    <td>@role.Name</td>
                    <td>@role.Permissions.Count</td>
                </tr>
            }
        </tbody>
    </table>
}
@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}